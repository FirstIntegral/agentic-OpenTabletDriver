<Project>

  <PropertyGroup>
    <VersionBase>0.6.7</VersionBase>
    <FrameworkBase>net10.0</FrameworkBase>
    <VersionPrefix>$(VersionBase)</VersionPrefix>
    <Version Condition="$(VersionSuffix.StartsWith('+'))">$(VersionPrefix)$(VersionSuffix)</Version>
    <Version Condition="$(VersionSuffix.StartsWith('-'))">$(VersionPrefix)$(VersionSuffix)</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup Label="NuGet Package">
    <Authors>InfinityGhost;X9VoiD</Authors>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <ProjectUrl>https://github.com/FirstIntegral/agentic-OpenTabletDriver</ProjectUrl>
    <RepositoryUrl>https://github.com/FirstIntegral/agentic-OpenTabletDriver</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>..\nupkg</PackageOutputPath>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Label="NuGet Metadata">
    <None Include="..\README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
